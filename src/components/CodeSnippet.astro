---
interface Props {
  title?: string;
  language?: string;
  code: string;
  filename?: string;
}

const { title, language = 'python', code, filename } = Astro.props;
---

<div class="my-6 rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-700">
  {(title || filename) && (
    <div class="bg-neutral-100 dark:bg-neutral-800 px-4 py-3 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
      <div class="flex items-center gap-2">
        {filename && (
          <span class="text-sm font-mono text-neutral-600 dark:text-neutral-400">
            {filename}
          </span>
        )}
        {title && !filename && (
          <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">
            {title}
          </span>
        )}
      </div>
      <div class="text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-500">
        {language}
      </div>
    </div>
  )}
  <div class="bg-neutral-900 dark:bg-neutral-950">
    <pre class="p-4 overflow-x-auto"><code class="text-sm font-mono text-neutral-100">{code}</code></pre>
  </div>
</div>

<style>
  code {
    font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
    line-height: 1.6;
  }
</style>
