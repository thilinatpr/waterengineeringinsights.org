---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article class="group bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg overflow-hidden hover:shadow-lg transition-all duration-200">
  <a href={`/insights/${slug}`} class="block p-6 no-underline">
    <time class="text-sm text-neutral-600 dark:text-neutral-400" datetime={pubDate.toISOString()}>
      {formattedDate}
    </time>
    <h3 class="mt-2 text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      {title}
    </h3>
    <p class="mt-3 text-neutral-600 dark:text-neutral-400 line-clamp-3">
      {description}
    </p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="px-2 py-1 text-xs font-medium bg-neutral-100 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 rounded">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>
